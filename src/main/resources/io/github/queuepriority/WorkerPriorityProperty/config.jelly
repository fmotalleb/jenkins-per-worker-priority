<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
  <f:entry title="Base priority" field="priority">
    <f:number default="0" />
  </f:entry>
  <f:entry title="Priority degradation per active job" field="degradation">
    <f:number min="0" default="0" />
  </f:entry>
</j:jelly>
